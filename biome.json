{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!.archive",
      "!.agent",
      "!out",
      "!build",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!next-env.d.ts",
      "!*.tsbuildinfo",
      "!public",
      "!styles/fontawesome-subset.css"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "noImgElement": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/lib/providers", "@/lib/providers/**", "@/lib/search/**", "@/lib/seo/**", "@/lib/loaders/**"],
                "message": "ARCH-1M: Feature の公開面 (@/features/<name>) から import する"
              },
              {
                "group": [
                  "@/hooks/useProfiles",
                  "@/hooks/useSync",
                  "@/hooks/useZipExport",
                  "@/hooks/useZipImport",
                  "@/hooks/useZipSync",
                  "@/hooks/useModpackAdd",
                  "@/hooks/useDependencyCheck",
                  "@/hooks/useCountUp",
                  "@/hooks/useScrollReveal",
                  "@/hooks/useEnvironmentLink",
                  "@/hooks/useFolderLinked",
                  "@/hooks/useInterruptedSync",
                  "@/hooks/useSyncHistory",
                  "@/hooks/useLoaderVersionOptions"
                ],
                "message": "ARCH-1M: ドメインフックは @/features/<name> から import する"
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["__tests__/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
