# =============================================================================
# DropMod (Next.js 16 App Router)
# =============================================================================

# --- Node / pnpm ---
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Logs ---
logs
!.agent/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Testing / coverage ---
coverage
*.lcov
.nyc_output

# --- Playwright (Sub-Phase 8-D) ---
/playwright-report/
/playwright/.cache/
/test-results/
/e2e/.auth/
/e2e-log.txt

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Next.js build output ---
.next/
out/
build/

# --- Turbopack cache (L5-8 修正) ---
.turbo/

# --- Persistent local build cache (scripts/build.ts) ---
.cache/

# --- Vercel ---
.vercel

# --- ESLint / Stylelint / Prettier caches ---
.eslintcache
.stylelintcache

# --- .env (except .env.example) ---
.env
.env.*
!.env.example

# --- Editor / OS ---
.DS_Store
*.pem
.vscode-test

# --- .archive/vite/ 内の pnpm 成果物 (退避元にあった node_modules 等) ---
.archive/**/node_modules
.archive/**/.next
.archive/**/dist
.archive/**/.vite

# --- Agent が調査目的で保存する参考画像 (コード成果物ではない) ---
/image-search
