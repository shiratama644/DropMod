# =============================================================================
# DropMod (Next.js 16 App Router)
# =============================================================================

# --- Node / pnpm ---
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Testing / coverage ---
coverage
*.lcov
.nyc_output

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Next.js build output ---
.next/
out/
build/

# --- Vercel ---
.vercel

# --- ESLint / Stylelint / Prettier caches ---
.eslintcache
.stylelintcache

# --- .env (except .env.example) ---
.env
.env.*
!.env.example

# --- Editor / OS ---
.DS_Store
*.pem
.vscode-test

# --- .archive/vite/ 内の pnpm 成果物 (退避元にあった node_modules 等) ---
.archive/**/node_modules
.archive/**/.next
.archive/**/dist
.archive/**/.vite
