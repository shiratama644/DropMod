# ============================================================================
# DropMod 環境変数サンプル
#
# 実際に使用する際は `.env.local` にコピー (git 管理外) してください。
# Vercel 本番/プレビューでは Vercel Dashboard の
#   Project Settings → Environment Variables
# から同じキーを設定してください。
# ============================================================================

# -------------------------------------------------------------
# APP_PROFILE  (任意・セキュリティ/ログのプロファイル切替)
# -------------------------------------------------------------
# 値: production | development   (未設定・不正値は fail-secure で production)
#
# APP_PROFILE に応じて以下が切り替わります:
#
#   | 項目                          | production          | development          |
#   |-------------------------------|---------------------|----------------------|
#   | CSP                           | Enforce (阻止)       | Report-Only (報告のみ) |
#   | HSTS                          | 2 年 + preload      | なし                 |
#   | upgrade-insecure-requests     | あり                | なし                 |
#   | API レート制限 (/api/*)        | 120/60 req/min      | 無効                 |
#   | サーバログ debug/info          | 抑制                | 出力                 |
#
# 解決優先度 (明示的に指定しなければ自動判定されるので、通常は設定不要):
#   1. APP_PROFILE   ← この変数 (最優先)
#   2. VERCEL_ENV    ← Vercel: production|preview → production / development → development
#   3. NODE_ENV      ← next dev → development / next build & start → production
#
# 注意:
#   - CSP / HSTS ヘッダーは **ビルド時に確定** します。値を変更したら
#     `pnpm build` をやり直してください (next dev は .env 変更で自動再起動)。
#   - ロガー / レート制限 / /api/health の profile はランタイム解決です。
#   - 主な用途: 本番相当の Enforce CSP をローカル dev で試す
#     (`APP_PROFILE=production` を .env.local に書いて next dev)、等。
#
# ⚠ 開発専用に development を常時指定したい場合は **.env.development** を使う:
#   .env.local は next dev だけでなく `pnpm build` (本番ビルド) にも適用されるため、
#   .env.local に APP_PROFILE=development を書きっぱなしにすると本番ビルドまで
#   CSP Report-Only で作られてしまいます。.env.development は next dev 時
#   (NODE_ENV=development) のみロードされるため build には影響しません。
#   (本番ビルドが development で作られそうな場合、build 時に警告 1 行が出ます)
#
# APP_PROFILE=production

# -------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL  (推奨・任意)
# -------------------------------------------------------------
# 本番サイトの正規 URL (末尾スラッシュ不要)。
# 主に og:image / og:url / sitemap / robots の baseUrl として使用。
# 未設定時は VERCEL_URL (Vercel 自動注入) → http://localhost:3000 の順で
# フォールバック。カスタムドメインを使う場合は必ず本番環境で設定してください。
#
# NEXT_PUBLIC_SITE_URL=https://dropmod.vercel.app

# -------------------------------------------------------------
# MODRINTH_USER_AGENT  (推奨)
# -------------------------------------------------------------
# Modrinth 側のレートリミット緩和のため、meaningful な User-Agent を設定。
# Server 側 (Route Handler / RSC) が Modrinth API を叩く際に送信されます。
# Modrinth の推奨フォーマット: "AppName/Version (Contact/URL)"
# 未設定時のデフォルト: "DropMod/1.1.0 (https://github.com/shiratama644/DropMod)"
#
# MODRINTH_USER_AGENT=DropMod/1.1.0 (https://your-fork.example.com; contact@example.com)

# -------------------------------------------------------------
# MODRINTH_TOKEN  (任意・将来用)
# -------------------------------------------------------------
# Modrinth Personal Access Token。プライベート Mod にアクセスする場合のみ
# 必要。現状は未使用。
#
# MODRINTH_TOKEN=

# -------------------------------------------------------------
# Vercel が自動注入する変数 (明示不要)
# -------------------------------------------------------------
# VERCEL=1
# VERCEL_URL=xxx.vercel.app   (プレビュー/本番の一意 URL)
# VERCEL_ENV=production | preview | development
# VERCEL_GIT_COMMIT_SHA=...

# -------------------------------------------------------------
# ブラウザに保存されるデータ (設定不要、参考情報)
# -------------------------------------------------------------
# LocalStorage:
#   dropmod_state_v2       — プロファイル + Mod セット + テーマの永続化
#   craftforge_state_v2    — レガシー (dropmod_state_v2 に自動移行される)
#
# Cookie:
#   dropmod_active_profile — SSR プロファイル反映用 (mcVersion/loader のみ)。
#                            1 年間有効、SameSite=Lax、Path=/
#                            Home ページの SSR で cookies() で読み取り、
#                            ユーザーの実プロファイル用 Mod カードを SSR HTML に含める。
#                            (Home hydration 直後の「ちらつき」を防ぐため)
#                            handleResetData でクリアされる。
