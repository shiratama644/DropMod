{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ]
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "e2e/**/*.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/lib/**/*.ts",
    "scripts/**/*.ts",
    "src/types/**/*.ts",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".archive"
  ]
}
