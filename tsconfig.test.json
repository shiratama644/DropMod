{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "e2e/**/*.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "types.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules", ".archive"]
}
